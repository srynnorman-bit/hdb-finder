# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LTA_DATAMALL_ACCOUNT_KEY: Required for Singapore LTA DataMall Bus Arrival v3 API requests.
# Users configure this via the Secrets panel in the AI Studio UI.
LTA_DATAMALL_ACCOUNT_KEY=""

# DATA_GOV_SG_API_KEY: Optional API key for Singapore Data.gov.sg API requests.
# Users configure this via the Secrets panel in the AI Studio UI.
DATA_GOV_SG_API_KEY=""

# ONEMAP_TOKEN or ONEMAP_EMAIL + ONEMAP_PASSWORD: For Singapore OneMap API (search, revgeocode, routing).
# Users configure either direct ONEMAP_TOKEN or credentials to mint a token via the Secrets panel in AI Studio UI.
ONEMAP_TOKEN=""
ONEMAP_EMAIL=""
ONEMAP_PASSWORD=""
